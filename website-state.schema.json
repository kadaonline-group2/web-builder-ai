{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UMKMWebsiteState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templateId",
    "theme",
    "meta",
    "hero",
    "about",
    "services",
    "testimonials",
    "contact"
  ],
  "properties": {
    "templateId": {
      "type": "string",
      "enum": [
        "template-services",
        "template-fnb",
        "template-retail"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryColor",
        "accentColor",
        "fontFamily"
      ],
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6})$"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6})$"
        },
        "fontFamily": {
          "type": "string",
          "enum": [
            "sans",
            "serif",
            "display"
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businessName",
        "category",
        "tagline"
      ],
      "properties": {
        "businessName": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "ctaText",
        "ctaWhatsappMessage"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "ctaText": {
          "type": "string",
          "minLength": 1
        },
        "ctaWhatsappMessage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story"
      ],
      "properties": {
        "story": {
          "type": "string",
          "minLength": 1
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "priceEstimate"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priceEstimate": {
            "type": "string",
            "minLength": 1
          },
          "iconKeyword": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "testimonials": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customerName",
          "review"
        ],
        "properties": {
          "customerName": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whatsappNumber",
        "address"
      ],
      "properties": {
        "whatsappNumber": {
          "type": "string",
          "pattern": "^62[0-9]{8,13}$"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "instagram": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
